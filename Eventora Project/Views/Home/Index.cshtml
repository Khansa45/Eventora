@{
    Layout = null;
    ViewData["Title"] = "Eventora - University Event Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
            :root {
                --primary-purple: #5B3A9E;
                --secondary-purple: #8064B5;
                --light-lavender: #F1ECF8;
                --page-bg: #F8F7FA;
                --dark-text: #282333;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--page-bg);
                color: var(--dark-text);
                margin: 0;
                padding: 0;
            }

            /* Navbar Styling */
            .navbar-custom {
                background-color: #FFFFFF;
                padding: 0.9rem 2.5rem;
                border-bottom: 1px solid #EFEBF5;
            }

            .brand-logo-box {
                width: 38px;
                height: 38px;
                background-color: var(--primary-purple);
                color: #FFFFFF;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
            }

            .brand-title {
                font-weight: 700;
                font-size: 1.15rem;
                color: var(--dark-text);
                line-height: 1.1;
                margin: 0;
            }

            .brand-subtitle {
                font-size: 0.65rem;
                font-weight: 600;
                letter-spacing: 0.06em;
                color: #7D768C;
                text-transform: uppercase;
                margin: 0;
            }

            .nav-link-custom {
                color: #5C556B;
                font-weight: 500;
                font-size: 0.92rem;
                padding: 0.5rem 1rem !important;
                transition: color 0.2s ease;
            }

                .nav-link-custom:hover,
                .nav-link-custom.active {
                    color: var(--primary-purple);
                    font-weight: 600;
                }

            .btn-signup {
                background-color: var(--primary-purple);
                color: #FFFFFF;
                font-weight: 600;
                font-size: 0.9rem;
                padding: 0.5rem 1.35rem;
                border-radius: 50px;
                border: none;
                transition: background-color 0.2s ease;
            }

                .btn-signup:hover {
                    background-color: #492D82;
                    color: #FFFFFF;
                }

            .profile-circle-btn {
                width: 36px;
                height: 36px;
                background-color: var(--primary-purple);
                color: #FFFFFF;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.95rem;
                text-decoration: none;
                transition: background-color 0.2s ease;
            }

                .profile-circle-btn:hover {
                    background-color: #492D82;
                    color: #FFFFFF;
                }

            /* Hero Section */
            .hero-section {
                background: radial-gradient(circle at 20% 20%, #371F6B 0%, #24124A 45%, #3B1E75 100%);
                min-height: 540px;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 5rem 1.5rem;
                color: #FFFFFF;
            }

            .hero-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background-color: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #E6DDF7;
                font-size: 0.72rem;
                font-weight: 600;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                padding: 0.4rem 1rem;
                border-radius: 50px;
                margin-bottom: 1.5rem;
            }

            .hero-badge-dot {
                width: 6px;
                height: 6px;
                background-color: #B69DF8;
                border-radius: 50%;
            }

            .hero-title {
                font-size: clamp(2.2rem, 4.5vw, 3.6rem);
                font-weight: 800;
                letter-spacing: -0.02em;
                margin-bottom: 1.15rem;
                color: #FFFFFF;
            }

            .hero-subtitle {
                font-size: 1.05rem;
                color: #D7CCE8;
                max-width: 610px;
                margin: 0 auto 2.25rem auto;
                line-height: 1.6;
                font-weight: 400;
            }

            .btn-hero-primary {
                background-color: #FFFFFF;
                color: var(--primary-purple);
                font-weight: 600;
                font-size: 0.95rem;
                padding: 0.8rem 1.75rem;
                border-radius: 10px;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
                transition: transform 0.15s ease, background-color 0.15s ease;
            }

                .btn-hero-primary:hover {
                    background-color: var(--light-lavender);
                    color: var(--primary-purple);
                    transform: translateY(-1px);
                }

            .btn-hero-secondary {
                background-color: rgba(255, 255, 255, 0.12);
                border: 1px solid rgba(255, 255, 255, 0.18);
                color: #FFFFFF;
                font-weight: 600;
                font-size: 0.95rem;
                padding: 0.8rem 1.75rem;
                border-radius: 10px;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: background-color 0.15s ease, transform 0.15s ease;
            }

                .btn-hero-secondary:hover {
                    background-color: rgba(255, 255, 255, 0.2);
                    color: #FFFFFF;
                    transform: translateY(-1px);
                }

            /* About Section */
            .about-section {
                background-color: var(--page-bg);
                padding: 4.5rem 1.5rem;
                text-align: center;
            }

            .about-eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.1em;
                color: var(--secondary-purple);
                text-transform: uppercase;
                margin-bottom: 1.1rem;
            }

                .about-eyebrow::before,
                .about-eyebrow::after {
                    content: "";
                    display: inline-block;
                    width: 24px;
                    height: 1.5px;
                    background-color: #C7B9E2;
                }

            .about-description {
                font-size: 1.15rem;
                color: var(--dark-text);
                max-width: 720px;
                margin: 0 auto 2rem auto;
                line-height: 1.65;
                font-weight: 500;
            }

            .feature-pill {
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                font-size: 0.82rem;
                font-weight: 600;
                padding: 0.5rem 1.1rem;
                border-radius: 50px;
                display: inline-flex;
                align-items: center;
                gap: 7px;
            }
    </style>
</head>
<body>

    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/">
                <div class="brand-logo-box">
                    <i class="bi bi-calendar2-week"></i>
                </div>
                <div>
                    <div class="brand-title">Eventora</div>
                    <div class="brand-subtitle">University Event Portal</div>
                </div>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#eventoraNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Center & Right Links -->
            <div class="collapse navbar-collapse" id="eventoraNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom active" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/Student">Browse Events</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <a href="/Account/Login" class="nav-link-custom text-decoration-none">Login</a>
                    <a href="/Account/Register" class="btn btn-signup">Sign Up</a>
                    <a href="/Account/Login" class="profile-circle-btn" title="Account Portal">
                        <i class="bi bi-person-fill"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="hero-badge">
                <span class="hero-badge-dot"></span>
                CAMPUS LIFE &amp; SOCIETY EVENTS
            </div>

            <h1 class="hero-title">Every Campus Moment Starts Here.</h1>

            <p class="hero-subtitle">
                Discover university events, connect with societies, and be part of unforgettable experiences.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="/Student" class="btn-hero-primary">
                    Explore Events <i class="bi bi-arrow-right"></i>
                </a>
                <a href="/Account/Register" class="btn-hero-secondary">
                    Get Started <i class="bi bi-plus-circle"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about-section">
        <div class="container">
            <div class="about-eyebrow">ABOUT EVENTORA</div>

            <p class="about-description">
                Eventora brings university students and societies together through one platform to discover events, manage registrations and participate in campus activities.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-3">
                <span class="feature-pill">
                    <i class="bi bi-compass"></i> Discover Events
                </span>
                <span class="feature-pill">
                    <i class="bi bi-people"></i> Society Coordination
                </span>
                <span class="feature-pill">
                    <i class="bi bi-person-check"></i> Instant Registration
                </span>
            </div>
        </div>
    </section>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>