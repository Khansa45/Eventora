@{
    Layout = null;
    ViewData["Title"] = "Eventora - University Event Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" asp-append-version="true" rel="stylesheet" />
</head>
<body class="eventora-home-body">
    <nav class="navbar navbar-expand-lg eventora-nav sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                <span class="eventora-brand-icon">
                    <i class="bi bi-calendar2-week"></i>
                </span>
                <span>
                    <span class="eventora-brand-title d-block">Eventora</span>
                    <span class="eventora-brand-subtitle d-block">University Event Portal</span>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#eventoraNav" aria-controls="eventoraNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="eventoraNav">
                <ul class="navbar-nav mx-auto mb-3 mb-lg-0 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link eventora-nav-link active" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link eventora-nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link eventora-nav-link" asp-controller="Student" asp-action="Dashboard">Browse Events</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <a class="btn eventora-nav-btn" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn eventora-nav-btn" asp-controller="Account" asp-action="Register">Sign Up</a>
                    <a class="eventora-profile-btn" asp-controller="Account" asp-action="Login" title="Account Portal" aria-label="Account Portal">
                        <i class="bi bi-person-fill"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <section class="eventora-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="eventora-hero-badge">
                        <span class="eventora-hero-badge-dot"></span>
                        Campus life &amp; society events
                    </div>
                    <h1 class="eventora-hero-title">Every campus moment starts here.</h1>
                    <p class="eventora-hero-subtitle">
                        Discover sports, seminars, cultural programs and society activities in one place. Eventora brings students, societies and administrators together.
                    </p>

                    <div class="eventora-role-selector" id="portals">
                        <div class="eventora-role-selector-heading">
                            <span class="eventora-role-selector-title">Sign in to your portal</span>
                            <span class="eventora-role-selector-hint">Choose your role</span>
                        </div>
                        <div class="row g-2 g-sm-3">
                            <div class="col-12 col-sm-4">
                                <a class="eventora-role-card eventora-role-admin h-100" asp-controller="Account" asp-action="Login" asp-route-role="Admin" aria-label="Admin login">
                                    <span class="eventora-role-card-icon"><i class="bi bi-shield-check"></i></span>
                                    <span class="eventora-role-card-copy">
                                        <span class="eventora-role-card-title">Admin Login</span>
                                        <span class="eventora-role-card-desc">Approve campus events</span>
                                    </span>
                                    <span class="eventora-role-card-arrow"><i class="bi bi-arrow-right"></i></span>
                                </a>
                            </div>
                            <div class="col-12 col-sm-4">
                                <a class="eventora-role-card eventora-role-head h-100" asp-controller="Account" asp-action="Login" asp-route-role="SocietyHead" aria-label="Society Head login">
                                    <span class="eventora-role-card-icon"><i class="bi bi-person-badge"></i></span>
                                    <span class="eventora-role-card-copy">
                                        <span class="eventora-role-card-title">Society Head Login</span>
                                        <span class="eventora-role-card-desc">Manage your society</span>
                                    </span>
                                    <span class="eventora-role-card-arrow"><i class="bi bi-arrow-right"></i></span>
                                </a>
                            </div>
                            <div class="col-12 col-sm-4">
                                <a class="eventora-role-card eventora-role-student h-100" asp-controller="Account" asp-action="Login" asp-route-role="Student" aria-label="Student login">
                                    <span class="eventora-role-card-icon"><i class="bi bi-mortarboard"></i></span>
                                    <span class="eventora-role-card-copy">
                                        <span class="eventora-role-card-title">Student Login</span>
                                        <span class="eventora-role-card-desc">Browse and register</span>
                                    </span>
                                    <span class="eventora-role-card-arrow"><i class="bi bi-arrow-right"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="eventora-hero-links">
                        <a class="eventora-hero-text-link" asp-controller="Student" asp-action="Dashboard">Explore events <i class="bi bi-arrow-right"></i></a>
                        <a class="eventora-hero-text-link" asp-controller="Account" asp-action="Register">Create student account <i class="bi bi-plus-circle"></i></a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="eventora-hero-image-frame">
                        <img src="~/Images/eventora-hero.jpg" class="eventora-hero-image img-fluid" alt="University events including sports, seminars, cultural activities and student societies" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="eventora-about">
        <div class="container">
            <div class="eventora-section-eyebrow">About Eventora</div>
            <h2 class="eventora-section-title">One portal for campus events</h2>
            <p class="eventora-section-text mt-3 mb-4">
                Eventora helps university students and societies discover events, manage registrations and participate in campus activities through a single, consistent experience.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <span class="eventora-feature-pill"><i class="bi bi-compass"></i> Discover Events</span>
                <span class="eventora-feature-pill"><i class="bi bi-people"></i> Society Coordination</span>
                <span class="eventora-feature-pill"><i class="bi bi-person-check"></i> Instant Registration</span>
            </div>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
