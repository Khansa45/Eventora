@model IEnumerable<Eventora_Project.Models.Event>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
    int totalEvents = ViewBag.TotalEvents ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int approvedCount = ViewBag.ApprovedCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;
    var pendingEvents = Model.Where(e => e.Status == "Pending").ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Eventora</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --primary-purple: #5B3A9E;
                --secondary-purple: #8064B5;
                --light-lavender: #F1ECF8;
                --page-bg: #F8F7FA;
                --dark-text: #282333;
                --text-muted: #6B7280;
                --border-color: #E5E0EE;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--page-bg);
                color: var(--dark-text);
                overflow-x: hidden;
            }

            .sidebar {
                width: 260px;
                min-height: 100vh;
                background-color: var(--light-lavender);
                border-right: 1px solid var(--border-color);
                padding: 1.75rem 1.25rem;
                position: fixed;
                top: 0;
                left: 0;
                z-index: 100;
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                padding: 0 0.5rem;
                margin-bottom: 2.25rem;
            }

            .brand-icon {
                width: 40px;
                height: 40px;
                background-color: var(--primary-purple);
                color: #ffffff;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.2rem;
                box-shadow: 0 4px 10px rgba(91, 58, 158, 0.22);
            }

            .brand-title {
                font-size: 1.3rem;
                font-weight: 800;
                color: var(--primary-purple);
                line-height: 1.1;
                display: block;
            }

            .brand-sub {
                font-size: 0.72rem;
                font-weight: 600;
                color: var(--text-muted);
                display: block;
            }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0.8rem 1rem;
                border-radius: 10px;
                color: var(--dark-text);
                font-weight: 600;
                font-size: 0.92rem;
                margin-bottom: 0.45rem;
                transition: all 0.2s ease;
            }

            .sidebar-nav .nav-link-content {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .sidebar-nav .nav-link:hover {
                background-color: #E6DDF5;
                color: var(--primary-purple);
            }

            .sidebar-nav .nav-link.active {
                background-color: var(--primary-purple);
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(91, 58, 158, 0.22);
            }

            .nav-badge {
                background-color: #E3DAF5;
                color: var(--primary-purple);
                font-size: 0.72rem;
                font-weight: 700;
                padding: 2px 8px;
                border-radius: 12px;
            }

            .main-wrapper {
                margin-left: 260px;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .topbar {
                background-color: #ffffff;
                border-bottom: 1px solid var(--border-color);
                padding: 1rem 2.5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .portal-tag {
                font-size: 0.72rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--secondary-purple);
                margin-bottom: 2px;
            }

            .page-topbar-title {
                font-size: 1.15rem;
                font-weight: 700;
                margin: 0;
                color: var(--dark-text);
            }

            .avatar-circle {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background-color: var(--primary-purple);
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
            }

            .content-container {
                padding: 2.25rem 2.5rem;
                max-width: 1400px;
                width: 100%;
            }

            .welcome-title {
                font-size: 1.8rem;
                font-weight: 800;
                color: var(--dark-text);
                letter-spacing: -0.02em;
                margin-bottom: 0.35rem;
            }

                .welcome-title span {
                    color: var(--primary-purple);
                }

            .welcome-subtitle {
                color: var(--text-muted);
                font-size: 0.95rem;
                margin-bottom: 0;
            }

            .stat-card {
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 16px;
                padding: 1.6rem;
                box-shadow: 0 2px 10px rgba(40, 35, 51, 0.03);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
                height: 100%;
            }

                .stat-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(91, 58, 158, 0.08);
                }

            .stat-label {
                font-size: 0.76rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-muted);
                margin-bottom: 0.5rem;
            }

            .stat-value {
                font-size: 2.15rem;
                font-weight: 800;
                color: var(--dark-text);
                line-height: 1.1;
                margin-bottom: 0.5rem;
            }

            .stat-subtext {
                font-size: 0.8rem;
                font-weight: 500;
                color: var(--text-muted);
            }

            .stat-icon-box {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.25rem;
                flex-shrink: 0;
            }

            .stat-icon-amber {
                background-color: #FEF3C7;
                color: #D97706;
            }

            .stat-icon-green {
                background-color: #DCFCE7;
                color: #16A34A;
            }

            .stat-icon-red {
                background-color: #FEE2E2;
                color: #DC2626;
            }

            .data-card {
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 16px;
                box-shadow: 0 2px 12px rgba(40, 35, 51, 0.03);
                overflow: hidden;
                margin-top: 2rem;
            }

            .data-card-header {
                padding: 1.5rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 1rem;
            }

            .header-icon-box {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.15rem;
            }

            .table-custom {
                margin-bottom: 0;
            }

                .table-custom thead th {
                    background-color: #FAF9FC;
                    color: var(--text-muted);
                    font-size: 0.74rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    padding: 0.95rem 2rem;
                    border-top: 1px solid var(--border-color);
                    border-bottom: 1px solid var(--border-color);
                }

                .table-custom tbody td {
                    padding: 1.2rem 2rem;
                    vertical-align: middle;
                    border-bottom: 1px solid #F1EFF6;
                    font-size: 0.9rem;
                }

                .table-custom tbody tr:last-child td {
                    border-bottom: none;
                }

                .table-custom tbody tr:hover {
                    background-color: #FCFAFF;
                }

            .event-row-icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.05rem;
                flex-shrink: 0;
            }

            .badge-pill-purple {
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                font-weight: 600;
                font-size: 0.78rem;
                padding: 0.4em 0.95em;
                border-radius: 20px;
                display: inline-block;
            }

            .badge-pending {
                background-color: #FEF3C7;
                color: #B45309;
                font-weight: 600;
                font-size: 0.78rem;
                padding: 0.4em 0.9em;
                border-radius: 20px;
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

            .badge-approved {
                background-color: #DCFCE7;
                color: #15803D;
                font-weight: 600;
                font-size: 0.78rem;
                padding: 0.4em 0.9em;
                border-radius: 20px;
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

            .badge-rejected {
                background-color: #FEE2E2;
                color: #DC2626;
                font-weight: 600;
                font-size: 0.78rem;
                padding: 0.4em 0.9em;
                border-radius: 20px;
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

            .btn-approve {
                background-color: var(--primary-purple);
                color: #ffffff;
                font-weight: 600;
                font-size: 0.82rem;
                padding: 0.45rem 1rem;
                border-radius: 8px;
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 5px;
                transition: all 0.2s;
            }

                .btn-approve:hover {
                    background-color: var(--secondary-purple);
                    color: #ffffff;
                }

            .btn-reject {
                background-color: #FEE2E2;
                color: #DC2626;
                font-weight: 600;
                font-size: 0.82rem;
                padding: 0.45rem 1rem;
                border-radius: 8px;
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 5px;
                transition: all 0.2s;
            }

                .btn-reject:hover {
                    background-color: #DC2626;
                    color: #ffffff;
                }

            .btn-view-all {
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                font-weight: 600;
                font-size: 0.84rem;
                padding: 0.5rem 1.1rem;
                border-radius: 10px;
                text-decoration: none;
                transition: all 0.2s;
            }

                .btn-view-all:hover {
                    background-color: var(--primary-purple);
                    color: #ffffff;
                }

            @@media (max-width: 991.98px) {
                .sidebar {
                    width: 100%;
                    min-height: auto;
                    position: relative;
                    padding: 1rem 1.5rem;
                }

                .main-wrapper {
                    margin-left: 0;
                }

                .content-container, .topbar {
                    padding: 1.5rem;
                }
            }
    </style>
</head>
<body class="eventora-dashboard">
    <a href="#adminMain" class="visually-hidden-focusable">Skip to content</a>
    <aside class="sidebar dashboard-sidebar">
        <a asp-controller="Home" asp-action="Index" class="brand-logo">
            <div class="brand-icon"><i class="bi bi-calendar-event-fill"></i></div>
            <div>
                <span class="brand-title">Eventora</span>
                <span class="brand-sub">University Admin</span>
            </div>
        </a>

        <nav class="nav flex-column sidebar-nav">
            <a asp-controller="Admin" asp-action="Dashboard" class="nav-link active" aria-current="page">
                <span class="nav-link-content"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></span>
            </a>

            <a href="#pendingSection" class="nav-link">
                <span class="nav-link-content"><i class="bi bi-clipboard-check"></i><span>Pending Approvals</span></span>
                <span class="nav-badge">@pendingCount</span>
            </a>

            <a href="#allEventsSection" class="nav-link">
                <span class="nav-link-content"><i class="bi bi-calendar-event"></i><span>All Events</span></span>
            </a>

            <hr class="my-3 opacity-25">

            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link w-100 border-0 bg-transparent text-start text-danger">
                    <span class="nav-link-content"><i class="bi bi-box-arrow-left"></i><span>Logout</span></span>
                </button>
            </form>
        </nav>
    </aside>

    <div class="offcanvas offcanvas-start dashboard-offcanvas" tabindex="-1" id="adminNavOffcanvas" aria-labelledby="adminNavOffcanvasLabel">
        <div class="offcanvas-header">
            <div>
                <div class="offcanvas-title" id="adminNavOffcanvasLabel">Eventora</div>
                <small class="text-muted">University Admin</small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <nav class="nav flex-column">
                <a asp-controller="Admin" asp-action="Dashboard" class="nav-link active" aria-current="page"><i class="bi bi-grid-1x2-fill me-2"></i>Dashboard</a>
                <a href="#pendingSection" class="nav-link" data-bs-dismiss="offcanvas"><i class="bi bi-clipboard-check me-2"></i>Pending Approvals</a>
                <a href="#allEventsSection" class="nav-link" data-bs-dismiss="offcanvas"><i class="bi bi-calendar-event me-2"></i>All Events</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link w-100 border-0 bg-transparent text-start text-danger"><i class="bi bi-box-arrow-left me-2"></i>Logout</button>
                </form>
            </nav>
        </div>
    </div>

    <div class="main-wrapper dashboard-main">

        <!-- Top Navbar -->
        <header class="topbar dashboard-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="dashboard-nav-toggle d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#adminNavOffcanvas" aria-controls="adminNavOffcanvas" aria-label="Open navigation"><i class="bi bi-list"></i></button>
                <div>
                    <div class="portal-tag">System Portal</div>
                    <h1 class="page-topbar-title">Admin Dashboard</h1>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="avatar-circle"><i class="bi bi-person-fill"></i></div>
                <div class="d-none d-sm-block">
                    <div class="fw-bold" style="font-size: 0.9rem; line-height: 1.2;">@(User.Identity?.Name ?? "Administrator")</div>
                    <small class="text-muted" style="font-size: 0.78rem;">System Admin</small>
                </div>
            </div>
        </header>

        <!-- Main Content Container -->
        <main id="adminMain" class="content-container dashboard-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="mb-4 pb-1">
                <h2 class="welcome-title dashboard-welcome-title">Welcome back, <span>Administrator!</span></h2>
                <p class="welcome-subtitle dashboard-welcome-subtitle">Manage university events and keep everything running smoothly.</p>
            </div>

            <!-- 4 Dynamic Stat Cards -->
            <div class="row g-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Total Events</div>
                            <div class="stat-value">@totalEvents.ToString("D2")</div>
                            <div class="stat-subtext text-primary fw-semibold">All submitted events</div>
                        </div>
                        <div class="stat-icon-box"><i class="bi bi-calendar4-event"></i></div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Pending Approvals</div>
                            <div class="stat-value">@pendingCount.ToString("D2")</div>
                            <div class="stat-subtext text-warning fw-semibold">Requires quick review</div>
                        </div>
                        <div class="stat-icon-box stat-icon-amber"><i class="bi bi-clock-history"></i></div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Approved Events</div>
                            <div class="stat-value">@approvedCount.ToString("D2")</div>
                            <div class="stat-subtext text-success fw-semibold">Live for students</div>
                        </div>
                        <div class="stat-icon-box stat-icon-green"><i class="bi bi-check-circle"></i></div>
                    </div>
                </div>

                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Rejected Events</div>
                            <div class="stat-value">@rejectedCount.ToString("D2")</div>
                            <div class="stat-subtext text-danger fw-semibold">Needs attention</div>
                        </div>
                        <div class="stat-icon-box stat-icon-red"><i class="bi bi-x-circle"></i></div>
                    </div>
                </div>
            </div>

            <!-- Table 1: Pending Event Approvals -->
            <div class="data-card" id="pendingSection">
                <div class="data-card-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="header-icon-box"><i class="bi bi-folder-check"></i></div>
                        <div>
                            <h3 class="h6 fw-bold mb-1">Pending Event Approvals</h3>
                            <p class="text-muted small mb-0">Societies waiting for admin authorization</p>
                        </div>
                    </div>
                    <span class="badge-pending">&bull; @pendingCount Pending Review</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Organizer</th>
                                <th>Event Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!pendingEvents.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No pending events right now. All submissions have been reviewed!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var ev in pendingEvents)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="event-row-icon"><i class="bi bi-calendar-event"></i></div>
                                                <div>
                                                    <div class="fw-bold">@ev.Title</div>
                                                    <small class="text-muted">@ev.Venue, @ev.City &bull; @ev.AvailableSeats Seats</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge-pill-purple">@(ev.SocietyHead?.FullName ?? ev.SocietyHead?.Email ?? "Society Head")</span></td>
                                        <td class="text-muted"><i class="bi bi-calendar3 me-1"></i> @ev.EventDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge-pending">&bull; Pending</span></td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <form asp-controller="Admin" asp-action="ApproveEvent" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@ev.Id" />
                                                    <button type="submit" class="btn-approve"><i class="bi bi-check-lg"></i> Approve</button>
                                                </form>
                                                <form asp-controller="Admin" asp-action="RejectEvent" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@ev.Id" />
                                                    <button type="submit" class="btn-reject"><i class="bi bi-x-lg"></i> Reject</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Table 2: All Events -->
            <div class="data-card" id="allEventsSection">
                <div class="data-card-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="header-icon-box"><i class="bi bi-calendar2-week"></i></div>
                        <div>
                            <h3 class="h6 fw-bold mb-1">All Campus Events</h3>
                            <p class="text-muted small mb-0">Complete list of submitted events and their statuses</p>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Category</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-end">Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No events found in the database yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var ev in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="event-row-icon"><i class="bi bi-star"></i></div>
                                                <div>
                                                    <div class="fw-bold">@ev.Title</div>
                                                    <small class="text-muted">@ev.Venue &bull; @ev.City</small>
                                                    <small class="text-muted d-block"><i class="bi bi-person-badge me-1"></i>@(ev.SocietyHead?.FullName ?? ev.SocietyHead?.Email ?? "Society Head")</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge-pill-purple">@(ev.Category?.Name ?? "General")</span></td>
                                        <td class="text-muted"><i class="bi bi-calendar3 me-1"></i> @ev.EventDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (ev.Status == "Approved")
                                            {
                                                <span class="badge-approved">&bull; Approved</span>
                                            }
                                            else if (ev.Status == "Rejected")
                                            {
                                                <span class="badge-rejected">&bull; Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge-pending">&bull; Pending</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2 align-items-center">
                                                <button type="button" class="btn-view-all border-0" data-bs-toggle="modal" data-bs-target="#eventDetails-@ev.Id"><i class="bi bi-eye"></i> Details</button>
                                                <form asp-controller="Admin" asp-action="DeleteEvent" method="post" class="m-0" onsubmit="return confirm('Delete this event permanently?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@ev.Id" />
                                                    <button type="submit" class="btn-reject"><i class="bi bi-trash"></i> Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @foreach (var ev in Model)
            {
                var organizer = ev.SocietyHead?.FullName ?? ev.SocietyHead?.Email;
                <div class="modal fade" id="eventDetails-@ev.Id" tabindex="-1" aria-labelledby="eventDetailsLabel-@ev.Id" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content" style="border-color: var(--border-color); border-radius: 16px; font-family: 'Inter', sans-serif;">
                            <div class="modal-header" style="background-color: var(--light-lavender); border-bottom: 1px solid var(--border-color); border-radius: 16px 16px 0 0;">
                                <h5 class="modal-title fw-bold" id="eventDetailsLabel-@ev.Id" style="color: var(--primary-purple);">
                                    <i class="bi bi-calendar-event me-2"></i>@ev.Title
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="stat-label">Venue</div>
                                        <div class="fw-semibold">@(ev.Venue + (string.IsNullOrWhiteSpace(ev.City) ? "" : ", " + ev.City))</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="stat-label">Date</div>
                                        <div class="fw-semibold"><i class="bi bi-calendar3 me-1"></i>@ev.EventDate.ToString("dd MMM yyyy")</div>
                                    </div>
                                    @if (ev.Category != null)
                                    {
                                        <div class="col-md-6">
                                            <div class="stat-label">Category</div>
                                            <div><span class="badge-pill-purple">@ev.Category.Name</span></div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(organizer))
                                    {
                                        <div class="col-md-6">
                                            <div class="stat-label">Society Head</div>
                                            <div class="fw-semibold"><i class="bi bi-person-badge me-1"></i>@organizer</div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ev.Description))
                                    {
                                        <div class="col-12">
                                            <div class="stat-label">Description</div>
                                            <div class="text-muted">@ev.Description</div>
                                        </div>
                                    }
                                    <div class="col-md-6">
                                        <div class="stat-label">Status</div>
                                        <div>
                                            @if (ev.Status == "Approved")
                                            {
                                                <span class="badge-approved">&bull; Approved</span>
                                            }
                                            else if (ev.Status == "Rejected")
                                            {
                                                <span class="badge-rejected">&bull; Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge-pending">&bull; Pending</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                                <button type="button" class="btn-view-all border-0" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>