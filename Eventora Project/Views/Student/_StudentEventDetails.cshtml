@model Eventora_Project.Models.Event
@{
    var isRegistered = ViewBag.IsRegistered is bool registered && registered;
    var location = string.IsNullOrWhiteSpace(Model.City)
        ? Model.Venue
        : $"{Model.Venue}, {Model.City}";
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="stat-label">Venue</div>
        <div class="fw-semibold">@location</div>
    </div>
    <div class="col-md-6">
        <div class="stat-label">Date</div>
        <div class="fw-semibold"><i class="bi bi-calendar3 me-1"></i>@Model.EventDate.ToString("dd MMMM yyyy, hh:mm tt")</div>
    </div>
    @if (Model.Category != null)
    {
        <div class="col-md-6">
            <div class="stat-label">Category</div>
            <div><span class="badge-pill-purple">@Model.Category.Name</span></div>
        </div>
    }
    <div class="col-md-6">
        <div class="stat-label">Seats Available</div>
        <div class="fw-semibold"><i class="bi bi-people-fill me-1"></i>@Model.AvailableSeats</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="col-12">
            <div class="stat-label">Description</div>
            <div class="text-muted">@Model.Description</div>
        </div>
    }
    <div class="col-12">
        <div class="stat-label">Registration</div>
        @if (isRegistered)
        {
            <span class="badge-confirmed"><i class="bi bi-check-circle-fill me-1"></i> You are registered</span>
        }
        else if (Model.AvailableSeats <= 0)
        {
            <span class="text-muted"><i class="bi bi-exclamation-circle me-1"></i> Seats are full</span>
        }
        else
        {
            <span class="text-muted"><i class="bi bi-info-circle me-1"></i> Registration is open</span>
        }
    </div>
</div>
