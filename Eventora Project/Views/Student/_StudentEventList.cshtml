@model IEnumerable<Eventora_Project.Models.Event>
@{
    var registeredEventIds = ViewBag.RegisteredEventIds as List<int> ?? new List<int>();
}

@if (!Model.Any())
{
    <div class="col-12">
        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
            <i class="bi bi-calendar-x fs-1 mb-2" style="color: var(--secondary-purple);"></i>
            <p class="mb-0">No approved events available right now. Check back soon!</p>
        </div>
    </div>
}
else
{
    foreach (var ev in Model)
    {
        bool isRegistered = registeredEventIds.Contains(ev.Id);
        <div class="col-md-4">
            <div class="event-card">
                <div class="event-banner">
                    <span class="category-tag">@(ev.Category?.Name ?? "General")</span>
                    <i class="bi bi-calendar2-check banner-icon"></i>
                    <span class="banner-venue-label">@ev.City</span>
                </div>
                <div class="event-card-body">
                    <h3 class="event-title">@ev.Title</h3>
                    <p class="text-muted small mb-3">@ev.Description</p>
                    <div class="event-meta">
                        <i class="bi bi-calendar3"></i>
                        <span>@ev.EventDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                    </div>
                    <div class="event-meta">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>@ev.Venue, @ev.City</span>
                    </div>
                    <div class="event-meta mb-4">
                        <i class="bi bi-people-fill"></i>
                        <span><strong>@ev.AvailableSeats</strong> seats available</span>
                    </div>

                    <div class="mt-auto">
                        <button type="button" class="btn-card-details js-view-details mb-2" data-event-id="@ev.Id">
                            <i class="bi bi-info-circle me-1"></i> View Details
                        </button>

                        @if (isRegistered)
                        {
                            <button type="button" class="btn-registered" disabled>
                                <i class="bi bi-check-circle-fill me-1"></i> Already Registered
                            </button>
                        }
                        else if (ev.AvailableSeats <= 0)
                        {
                            <button type="button" class="btn btn-secondary w-100 rounded-3" disabled>
                                Seats Full
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Student" asp-action="RegisterEvent" method="post" data-ajax-register="true">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@ev.Id" />
                                <button type="submit" class="btn-card-details js-register-event" data-event-id="@ev.Id">
                                    Register Now &rarr;
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
