@model IEnumerable<Eventora_Project.Models.Event>
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = null;
    var myRegistrations = ViewBag.MyRegistrations as List<Eventora_Project.Models.Registration> ?? new List<Eventora_Project.Models.Registration>();
    var registeredEventIds = ViewBag.RegisteredEventIds as List<int> ?? new List<int>();
    var categories = ViewBag.Categories as List<Eventora_Project.Models.Category> ?? new List<Eventora_Project.Models.Category>();
    int availableCount = Model.Count();
    int regCount = myRegistrations.Count;
    int upcomingCount = Model.Count(e => e.EventDate >= DateTime.Now);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Eventora</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
            :root {
                --primary-purple: #5B3A9E;
                --secondary-purple: #8064B5;
                --light-lavender: #F1ECF8;
                --page-bg: #F8F7FA;
                --dark-text: #282333;
                --text-muted: #6B7280;
                --border-color: #E5E0EE;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: var(--page-bg);
                color: var(--dark-text);
                overflow-x: hidden;
            }

            .top-navbar {
                background-color: #ffffff;
                border-bottom: 1px solid var(--border-color);
                height: 70px;
                padding: 0 2rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 1030;
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--primary-purple);
            }

            .brand-icon {
                width: 36px;
                height: 36px;
                background-color: var(--primary-purple);
                color: #ffffff;
                border-radius: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
            }

            .portal-pill {
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                font-size: 0.78rem;
                font-weight: 700;
                padding: 0.35rem 0.85rem;
                border-radius: 20px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                margin-left: 1rem;
            }

            .student-initials {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                font-weight: 700;
                font-size: 0.85rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .btn-logout {
                background-color: #ffffff;
                border: 1px solid var(--border-color);
                color: var(--dark-text);
                font-size: 0.84rem;
                font-weight: 600;
                padding: 0.45rem 1rem;
                border-radius: 9px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
            }

                .btn-logout:hover {
                    background-color: #FEE2E2;
                    border-color: #FECACA;
                    color: #DC2626;
                }

            .sidebar {
                width: 250px;
                background-color: var(--light-lavender);
                border-right: 1px solid var(--border-color);
                position: fixed;
                top: 70px;
                bottom: 0;
                left: 0;
                padding: 1.75rem 1.25rem;
                z-index: 1020;
            }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.8rem 1rem;
                border-radius: 10px;
                color: var(--dark-text);
                font-weight: 600;
                font-size: 0.92rem;
                margin-bottom: 0.5rem;
                transition: all 0.2s ease;
            }

                .sidebar-nav .nav-link:hover {
                    background-color: #E6DDF5;
                    color: var(--primary-purple);
                }

                .sidebar-nav .nav-link.active {
                    background-color: var(--primary-purple);
                    color: #ffffff;
                    box-shadow: 0 4px 12px rgba(91, 58, 158, 0.22);
                }

            .main-content {
                margin-left: 250px;
                margin-top: 70px;
                padding: 2.25rem 2.5rem;
                min-height: calc(100vh - 70px);
            }

            .content-inner {
                max-width: 1360px;
            }

            .welcome-title {
                font-size: 1.75rem;
                font-weight: 800;
                color: var(--dark-text);
                letter-spacing: -0.02em;
                margin-bottom: 0.3rem;
            }

            .welcome-subtitle {
                color: var(--text-muted);
                font-size: 0.94rem;
                margin-bottom: 0;
            }

            .stat-card {
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 14px;
                padding: 1.5rem 1.75rem;
                box-shadow: 0 2px 10px rgba(40, 35, 51, 0.03);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

                .stat-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(91, 58, 158, 0.08);
                }

            .stat-label {
                font-size: 0.76rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-muted);
                margin-bottom: 0.4rem;
            }

            .stat-value {
                font-size: 2rem;
                font-weight: 800;
                color: var(--primary-purple);
                line-height: 1.1;
            }

            .stat-icon-box {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background-color: var(--light-lavender);
                color: var(--primary-purple);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.2rem;
            }

            .section-heading {
                font-size: 1.05rem;
                font-weight: 700;
                color: var(--dark-text);
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 0;
            }

                .section-heading i {
                    color: var(--primary-purple);
                }

            .event-card {
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 2px 12px rgba(40, 35, 51, 0.03);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
                height: 100%;
                display: flex;
                flex-direction: column;
            }

                .event-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 10px 24px rgba(91, 58, 158, 0.1);
                }

            .event-banner {
                background: linear-gradient(180deg, #EBE4F7 0%, #F4F0FA 100%);
                height: 135px;
                position: relative;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 1rem;
            }

            .category-tag {
                position: absolute;
                top: 12px;
                right: 12px;
                background-color: #ffffff;
                color: var(--primary-purple);
                font-size: 0.7rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                padding: 0.3rem 0.75rem;
                border-radius: 20px;
                box-shadow: 0 2px 6px rgba(40, 35, 51, 0.06);
            }

            .banner-icon {
                font-size: 1.75rem;
                color: var(--secondary-purple);
                margin-bottom: 0.35rem;
            }

            .banner-venue-label {
                font-size: 0.72rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--secondary-purple);
            }

            .event-card-body {
                padding: 1.4rem 1.5rem;
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }

            .event-title {
                font-size: 1.1rem;
                font-weight: 700;
                color: var(--dark-text);
                margin-bottom: 0.75rem;
            }

            .event-meta {
                font-size: 0.85rem;
                color: var(--text-muted);
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 0.45rem;
            }

                .event-meta i {
                    color: var(--secondary-purple);
                }

            .btn-card-details {
                background-color: var(--primary-purple);
                color: #ffffff;
                font-weight: 600;
                font-size: 0.88rem;
                padding: 0.65rem 1rem;
                border-radius: 10px;
                text-align: center;
                text-decoration: none;
                border: none;
                width: 100%;
                display: block;
                transition: background-color 0.2s ease;
            }

                .btn-card-details:hover {
                    background-color: var(--secondary-purple);
                    color: #ffffff;
                }

            .btn-registered {
                background-color: #DCFCE7;
                color: #15803D;
                font-weight: 700;
                font-size: 0.88rem;
                padding: 0.65rem 1rem;
                border-radius: 10px;
                text-align: center;
                border: 1px solid #BBF7D0;
                width: 100%;
                cursor: default;
            }

            .table-card {
                background: #ffffff;
                border: 1px solid var(--border-color);
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 2px 12px rgba(40, 35, 51, 0.03);
            }

            .table-custom {
                margin-bottom: 0;
            }

                .table-custom thead th {
                    background-color: #FAF9FC;
                    color: var(--text-muted);
                    font-size: 0.74rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.06em;
                    padding: 1rem 1.75rem;
                    border-bottom: 1px solid var(--border-color);
                }

                .table-custom tbody td {
                    padding: 1.15rem 1.75rem;
                    vertical-align: middle;
                    border-bottom: 1px solid #F1EFF6;
                    font-size: 0.9rem;
                }

                .table-custom tbody tr:last-child td {
                    border-bottom: none;
                }

                .table-custom tbody tr:hover {
                    background-color: #FCFAFF;
                }

            .table-event-icon {
                color: var(--primary-purple);
                font-size: 1rem;
                margin-right: 10px;
            }

            .badge-confirmed {
                background-color: #DCFCE7;
                color: #15803D;
                font-weight: 600;
                font-size: 0.78rem;
                padding: 0.4em 0.85em;
                border-radius: 8px;
                display: inline-flex;
                align-items: center;
                gap: 5px;
            }

            .btn-cancel-reg {
                background-color: #FEE2E2;
                color: #DC2626;
                font-weight: 600;
                font-size: 0.82rem;
                padding: 0.45rem 1rem;
                border-radius: 8px;
                border: none;
                transition: all 0.2s;
            }

                .btn-cancel-reg:hover {
                    background-color: #DC2626;
                    color: #ffffff;
                }

            @@media (max-width: 991.98px) {
                .sidebar {
                    position: relative;
                    width: 100%;
                    top: 70px;
                    padding: 1rem 1.5rem;
                }

                .main-content {
                    margin-left: 0;
                    padding: 1.5rem;
                }
            }
    </style>
</head>
<body>

    <!-- Top Header Bar -->
    <header class="top-navbar">
        <div class="d-flex align-items-center">
            <a asp-controller="Home" asp-action="Index" class="brand-logo">
                <div class="brand-icon"><i class="bi bi-calendar-event-fill"></i></div>
                <span>Eventora</span>
            </a>
            <span class="portal-pill d-none d-sm-inline-flex">
                <i class="bi bi-mortarboard-fill"></i> University Portal
            </span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="student-initials">ST</div>
                <div class="d-none d-md-block text-start">
                    <div class="fw-bold" style="font-size: 0.88rem; line-height: 1.2;">@(User.Identity?.Name ?? "Student")</div>
                    <small class="text-muted" style="font-size: 0.75rem;">Student Account</small>
                </div>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
        </div>
    </header>

    <!-- Left Navigation Sidebar -->
    <aside class="sidebar">
        <nav class="nav flex-column sidebar-nav">
            <a asp-controller="Student" asp-action="Dashboard" class="nav-link active">
                <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
            </a>
            <a href="#browseEvents" class="nav-link">
                <i class="bi bi-compass"></i><span>Browse Events</span>
            </a>
            <a href="#myRegistrations" class="nav-link">
                <i class="bi bi-ticket-perforated"></i><span>My Registrations</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content Body -->
    <main class="main-content">
        <div class="content-inner">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Welcome Section -->
            <div class="mb-4">
                <h1 class="welcome-title">Welcome back, Student!</h1>
                <p class="welcome-subtitle">Explore approved events happening on campus and register in one click.</p>
            </div>

            <!-- 3 Dynamic Stat Cards -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="stat-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Available Events</div>
                            <div class="stat-value">@availableCount.ToString("D2")</div>
                        </div>
                        <div class="stat-icon-box"><i class="bi bi-calendar4-event"></i></div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">My Registrations</div>
                            <div class="stat-value">@regCount.ToString("D2")</div>
                        </div>
                        <div class="stat-icon-box"><i class="bi bi-ticket-detailed"></i></div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="stat-card d-flex justify-content-between align-items-center">
                        <div>
                            <div class="stat-label">Upcoming Events</div>
                            <div class="stat-value">@upcomingCount.ToString("D2")</div>
                        </div>
                        <div class="stat-icon-box"><i class="bi bi-clock"></i></div>
                    </div>
                </div>
            </div>

            <!-- Search & Category Filter Bar -->
            <div class="card border-0 shadow-sm p-3 mb-4" id="browseEvents" style="border-radius: 14px;">
                <form asp-controller="Student" asp-action="Dashboard" method="get" class="row g-2 align-items-center">
                    <div class="col-md-6">
                        <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search events by title or city..." />
                    </div>
                    <div class="col-md-4">
                        <select name="categoryId" class="form-select">
                            <option value="0">All Categories</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" selected="@(Context.Request.Query["categoryId"] == cat.Id.ToString())">@cat.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn-card-details py-2"><i class="bi bi-search me-1"></i> Filter</button>
                    </div>
                </form>
            </div>

            <!-- Approved Events Section -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="section-heading"><i class="bi bi-stars"></i> Approved Campus Events</h2>
                <span class="text-muted small">Showing @availableCount approved event(s)</span>
            </div>

            <div class="row g-4 mb-5">
                @if (!Model.Any())
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
                            <i class="bi bi-calendar-x fs-1 mb-2" style="color: var(--secondary-purple);"></i>
                            <p class="mb-0">No approved events available right now. Check back soon!</p>
                        </div>
                    </div>
                }
                else
                {
                    foreach (var ev in Model)
                    {
                        bool isRegistered = registeredEventIds.Contains(ev.Id);
                        <div class="col-md-4">
                            <div class="event-card">
                                <div class="event-banner">
                                    <span class="category-tag">@(ev.Category?.Name ?? "General")</span>
                                    <i class="bi bi-calendar2-check banner-icon"></i>
                                    <span class="banner-venue-label">@ev.City</span>
                                </div>
                                <div class="event-card-body">
                                    <h3 class="event-title">@ev.Title</h3>
                                    <p class="text-muted small mb-3">@ev.Description</p>
                                    <div class="event-meta">
                                        <i class="bi bi-calendar3"></i>
                                        <span>@ev.EventDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                                    </div>
                                    <div class="event-meta">
                                        <i class="bi bi-geo-alt-fill"></i>
                                        <span>@ev.Venue, @ev.City</span>
                                    </div>
                                    <div class="event-meta mb-4">
                                        <i class="bi bi-people-fill"></i>
                                        <span><strong>@ev.AvailableSeats</strong> seats available</span>
                                    </div>

                                    <div class="mt-auto">
                                        @if (isRegistered)
                                        {
                                            <button type="button" class="btn-registered" disabled>
                                                <i class="bi bi-check-circle-fill me-1"></i> Already Registered
                                            </button>
                                        }
                                        else if (ev.AvailableSeats <= 0)
                                        {
                                            <button type="button" class="btn btn-secondary w-100 rounded-3" disabled>
                                                Seats Full
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-controller="Student" asp-action="RegisterEvent" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="eventId" value="@ev.Id" />
                                                <button type="submit" class="btn-card-details">
                                                    Register Now &rarr;
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- My Registrations Table Section -->
            <div class="d-flex justify-content-between align-items-center mb-3" id="myRegistrations">
                <h2 class="section-heading"><i class="bi bi-list-ul"></i> My Registrations</h2>
                <span class="text-muted small">Your enrolled events</span>
            </div>

            <div class="table-card">
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Category</th>
                                <th>Event Date</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!myRegistrations.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        You haven't registered for any events yet. Browse events above to join!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var reg in myRegistrations)
                                {
                                    <tr>
                                        <td class="fw-bold">
                                            <i class="bi bi-ticket-perforated table-event-icon"></i> @(reg.Event?.Title ?? "Event")
                                        </td>
                                        <td><span class="badge bg-light text-dark">@(reg.Event?.Category?.Name ?? "General")</span></td>
                                        <td class="text-muted">@(reg.Event?.EventDate.ToString("dd MMM yyyy") ?? "-")</td>
                                        <td><span class="badge-confirmed"><i class="bi bi-check-circle-fill"></i> @reg.Status</span></td>
                                        <td class="text-end">
                                            <form asp-controller="Student" asp-action="CancelRegistration" method="post" class="d-inline" onsubmit="return confirm('Cancel your registration for this event?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="registrationId" value="@reg.Id" />
                                                <button type="submit" class="btn-cancel-reg">Cancel Registration</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>