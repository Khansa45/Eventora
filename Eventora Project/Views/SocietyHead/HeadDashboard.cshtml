@model IEnumerable<Eventora_Project.Models.Event>
@{
    Layout = null;
    var categories = ViewBag.Categories as List<Eventora_Project.Models.Category> ?? new List<Eventora_Project.Models.Category>();
    int totalCount = Model.Count();
    int approvedCount = Model.Count(e => e.Status == "Approved");
    int pendingCount = Model.Count(e => e.Status == "Pending");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventora - Society Head Dashboard</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                font-family: 'Inter', sans-serif;
                background-color: #F8F7FA;
                color: #23222A;
                font-size: 0.875rem;
            }

            .text-primary-brand {
                color: #5B3A9E !important;
            }

            .bg-primary-brand {
                background-color: #5B3A9E !important;
            }

            .btn-primary-brand {
                background-color: #5B3A9E;
                color: #fff;
                border: none;
            }

                .btn-primary-brand:hover {
                    background-color: #4a2e82;
                    color: #fff;
                }

            .sidebar {
                width: 250px;
                background-color: #F1ECF8;
                min-height: calc(100vh - 60px);
            }

            .nav-link {
                color: #4A4658;
                font-weight: 500;
                padding: 0.6rem 0.85rem;
                border-radius: 6px;
            }

                .nav-link:hover, .nav-link.active {
                    background-color: #5B3A9E;
                    color: #fff;
                }
    </style>
</head>
<body class="eventora-dashboard">
    <a href="#headMain" class="visually-hidden-focusable">Skip to content</a>
    <nav class="navbar navbar-expand bg-white border-bottom px-4 sticky-top dashboard-topbar">
        <div class="container-fluid">
            <button type="button" class="dashboard-nav-toggle d-lg-none me-2" data-bs-toggle="offcanvas" data-bs-target="#headNavOffcanvas" aria-controls="headNavOffcanvas" aria-label="Open navigation"><i class="bi bi-list"></i></button>
            <a class="navbar-brand fw-bold text-primary-brand d-flex align-items-center gap-2" asp-controller="SocietyHead" asp-action="Dashboard">
                <i class="bi bi-calendar2-event-fill"></i> Eventora <span class="text-muted fw-normal fs-6">| Society Portal</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-sm-block">
                    <span class="d-block fw-semibold small">@User.Identity?.Name</span>
                    <span class="text-muted" style="font-size: 0.75rem;">Society Head</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right"></i> Logout</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="offcanvas offcanvas-start dashboard-offcanvas" tabindex="-1" id="headNavOffcanvas" aria-labelledby="headNavOffcanvasLabel">
        <div class="offcanvas-header">
            <div>
                <div class="offcanvas-title" id="headNavOffcanvasLabel">Eventora</div>
                <small class="text-muted">Society Portal</small>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <nav class="nav flex-column">
                <a asp-controller="SocietyHead" asp-action="Dashboard" class="nav-link active" aria-current="page"><i class="bi bi-grid-1x2-fill me-2"></i>Dashboard</a>
                <a href="#myEventsTable" class="nav-link" data-bs-dismiss="offcanvas"><i class="bi bi-calendar-check me-2"></i>My Events</a>
                <a href="#" class="nav-link" data-bs-toggle="modal" data-bs-target="#createEventModal"><i class="bi bi-plus-circle me-2"></i>Create Event</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link w-100 border-0 bg-transparent text-start text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
            </nav>
        </div>
    </div>

    <div class="d-flex dashboard-main">
        <!-- Sidebar -->
        <aside class="sidebar dashboard-sidebar p-3 d-flex flex-column justify-content-between">
            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a asp-controller="SocietyHead" asp-action="Dashboard" class="nav-link active" aria-current="page">
                        <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#myEventsTable" class="nav-link">
                        <i class="bi bi-calendar-check me-2"></i> My Events
                    </a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link" data-bs-toggle="modal" data-bs-target="#createEventModal">
                        <i class="bi bi-plus-circle me-2"></i> Create Event
                    </a>
                </li>
            </ul>
            <div class="px-2 text-muted small">
                <i class="bi bi-shield-check text-primary-brand"></i> Fall 2026 Term
            </div>
        </aside>

        <!-- Main Content -->
        <main id="headMain" class="flex-grow-1 dashboard-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="mb-4">
                <h1 class="h4 dashboard-welcome-title mb-1">Welcome back, Society Head!</h1>
                <p class="text-muted dashboard-welcome-subtitle mb-0">Manage your society events in one place.</p>
            </div>

            <!-- Dynamic Statistics Row -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Total Events</span>
                            <h3 class="stat-value mb-0 mt-1">@totalCount.ToString("D2")</h3>
                        </div>
                        <div class="stat-icon-box"><i class="bi bi-calendar-event"></i></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Approved Events</span>
                            <h3 class="stat-value mb-0 mt-1">@approvedCount.ToString("D2")</h3>
                        </div>
                        <div class="stat-icon-box stat-icon-green"><i class="bi bi-check-circle"></i></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm p-3 d-flex flex-row align-items-center justify-content-between">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Pending Events</span>
                            <h3 class="stat-value mb-0 mt-1">@pendingCount.ToString("D2")</h3>
                        </div>
                        <div class="stat-icon-box stat-icon-amber"><i class="bi bi-hourglass-split"></i></div>
                    </div>
                </div>
            </div>

            <!-- My Events Section -->
            <div id="myEventsTable">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="dashboard-section-title mb-0"><i class="bi bi-list-nested me-1"></i> My Events</h5>
                    <button type="button" class="btn btn-primary-brand btn-sm" data-bs-toggle="modal" data-bs-target="#createEventModal">
                        <i class="bi bi-plus-lg me-1"></i> Create New Event
                    </button>
                </div>

                <div class="card dashboard-card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="py-3 px-3">Event Name</th>
                                    <th class="py-3">Category</th>
                                    <th class="py-3">Event Date</th>
                                    <th class="py-3">Venue / City</th>
                                    <th class="py-3">Seats</th>
                                    <th class="py-3">Status</th>
                                    <th class="py-3 text-end px-3">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            No events created yet. Click <strong>"Create New Event"</strong> to add your first event!
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="px-3 fw-semibold">@item.Title</td>
                                            <td><span class="badge bg-light text-primary-brand">@(item.Category?.Name ?? "General")</span></td>
                                            <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                            <td>@item.Venue, @item.City</td>
                                            <td>@item.AvailableSeats</td>
                                            <td>
                                                @if (item.Status == "Approved")
                                                {
                                                    <span class="badge bg-success">Approved</span>
                                                }
                                                else if (item.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                            </td>
                                            <td class="text-end px-3">
                                                <button type="button" class="btn btn-outline-primary btn-sm me-1"
                                                        onclick="openEditModal('@item.Id', '@Html.Raw(item.Title.Replace("'", "\\'"))', '@Html.Raw(item.Description.Replace("'", "\\'"))', '@item.CategoryId', '@item.EventDate.ToString("yyyy-MM-ddTHH:mm")', '@Html.Raw(item.Venue.Replace("'", "\\'"))', '@Html.Raw(item.City.Replace("'", "\\'"))', '@item.TotalCapacity')">
                                                    Edit
                                                </button>
                                                <form asp-controller="SocietyHead" asp-action="DeleteEvent" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- CREATE EVENT MODAL -->
    <div class="modal fade" id="createEventModal" tabindex="-1" aria-labelledby="createEventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary-brand text-white">
                    <h5 class="modal-title fw-bold" id="createEventModalLabel"><i class="bi bi-calendar-plus me-2"></i>Create New Event</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="SocietyHead" asp-action="CreateEvent" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="createTitle" class="form-label fw-semibold">Event Title</label>
                            <input type="text" name="Title" id="createTitle" class="form-control" placeholder="e.g., AI & Tech Summit" required />
                            @Html.ValidationMessage("Title", null, new { @class = "text-danger small" })
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label for="createCategoryId" class="form-label fw-semibold">Category</label>
                                <select name="CategoryId" id="createCategoryId" class="form-select" required>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                @Html.ValidationMessage("CategoryId", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label for="createEventDate" class="form-label fw-semibold">Date & Time</label>
                                <input type="datetime-local" name="EventDate" id="createEventDate" class="form-control" required />
                                @Html.ValidationMessage("EventDate", null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label for="createVenue" class="form-label fw-semibold">Venue</label>
                                <input type="text" name="Venue" id="createVenue" class="form-control" placeholder="e.g., Main Auditorium" required />
                                @Html.ValidationMessage("Venue", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-3">
                                <label for="createCity" class="form-label fw-semibold">City</label>
                                <input type="text" name="City" id="createCity" class="form-control" value="Lahore" required />
                                @Html.ValidationMessage("City", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-3">
                                <label for="createAvailableSeats" class="form-label fw-semibold">Seats</label>
                                <input type="number" name="AvailableSeats" id="createAvailableSeats" class="form-control" min="1" max="5000" value="100" required />
                                @Html.ValidationMessage("AvailableSeats", null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="mb-2">
                            <label for="createDescription" class="form-label fw-semibold">Description</label>
                            <textarea name="Description" id="createDescription" class="form-control" rows="3" placeholder="Brief details about the event..." required></textarea>
                            @Html.ValidationMessage("Description", null, new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-brand">Submit for Approval</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- EDIT EVENT MODAL -->
    <div class="modal fade" id="editEventModal" tabindex="-1" aria-labelledby="editEventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary-brand text-white">
                    <h5 class="modal-title fw-bold" id="editEventModalLabel"><i class="bi bi-pencil-square me-2"></i>Edit Event</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="SocietyHead" asp-action="EditEvent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="editId" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="editTitle" class="form-label fw-semibold">Event Title</label>
                            <input type="text" name="Title" id="editTitle" class="form-control" required />
                            @Html.ValidationMessage("Title", null, new { @class = "text-danger small" })
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label for="editCategoryId" class="form-label fw-semibold">Category</label>
                                <select name="CategoryId" id="editCategoryId" class="form-select" required>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                                @Html.ValidationMessage("CategoryId", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                <label for="editEventDate" class="form-label fw-semibold">Date & Time</label>
                                <input type="datetime-local" name="EventDate" id="editEventDate" class="form-control" required />
                                @Html.ValidationMessage("EventDate", null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label for="editVenue" class="form-label fw-semibold">Venue</label>
                                <input type="text" name="Venue" id="editVenue" class="form-control" required />
                                @Html.ValidationMessage("Venue", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-3">
                                <label for="editCity" class="form-label fw-semibold">City</label>
                                <input type="text" name="City" id="editCity" class="form-control" required />
                                @Html.ValidationMessage("City", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-3">
                                <label for="editTotalCapacity" class="form-label fw-semibold">Total Capacity</label>
                                <input type="number" name="TotalCapacity" id="editTotalCapacity" class="form-control" min="1" max="5000" required />
                                @Html.ValidationMessage("TotalCapacity", null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="mb-2">
                            <label for="editDescription" class="form-label fw-semibold">Description</label>
                            <textarea name="Description" id="editDescription" class="form-control" rows="3" required></textarea>
                            @Html.ValidationMessage("Description", null, new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-brand">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            function openEditModal(id, title, desc, catId, date, venue, city, totalCapacity) {
                document.getElementById('editId').value = id;
                document.getElementById('editTitle').value = title;
                document.getElementById('editDescription').value = desc;
                document.getElementById('editCategoryId').value = catId;
                document.getElementById('editEventDate').value = date;
                document.getElementById('editVenue').value = venue;
                document.getElementById('editCity').value = city;
                document.getElementById('editTotalCapacity').value = totalCapacity;

                var modal = new bootstrap.Modal(document.getElementById('editEventModal'));
                modal.show();
            }
    </script>
</body>
</html>