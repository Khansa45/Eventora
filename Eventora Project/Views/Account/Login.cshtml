@{
    Layout = null;
    ViewData["Title"] = "Eventora - Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
            :root {
                --primary-purple: #5B3A9E;
                --secondary-purple: #8064B5;
                --light-lavender: #F1ECF8;
                --page-bg: #F8F7FA;
                --dark-text: #282333;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--page-bg);
                color: var(--dark-text);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 2.5rem 1rem;
            }

            .brand-header {
                text-align: center;
                margin-bottom: 1.75rem;
            }

            .brand-logo-box {
                width: 52px;
                height: 52px;
                background-color: var(--primary-purple);
                color: #FFFFFF;
                border-radius: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
                box-shadow: 0 4px 12px rgba(91, 58, 158, 0.2);
                margin-bottom: 0.75rem;
            }

            .brand-title {
                font-weight: 800;
                font-size: 1.75rem;
                color: var(--primary-purple);
                letter-spacing: -0.02em;
                margin: 0;
                line-height: 1.1;
            }

            .brand-subtitle {
                font-size: 0.72rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                color: #7D768C;
                text-transform: uppercase;
                margin-top: 0.35rem;
            }

            .login-card {
                background-color: #FFFFFF;
                border: 1px solid #EFEBF5;
                border-radius: 20px;
                box-shadow: 0 10px 30px rgba(91, 58, 158, 0.06);
                width: 100%;
                max-width: 480px;
                padding: 2.5rem;
            }

            .card-heading {
                text-align: center;
                margin-bottom: 2rem;
            }

                .card-heading h2 {
                    font-weight: 700;
                    font-size: 1.5rem;
                    color: var(--dark-text);
                    margin-bottom: 0.3rem;
                }

                .card-heading p {
                    font-size: 0.9rem;
                    color: #7D768C;
                    margin: 0;
                }

            .form-label {
                font-size: 0.85rem;
                font-weight: 600;
                color: #4A4356;
                margin-bottom: 0.4rem;
            }

            .input-group-text {
                background-color: #FAFAFC;
                border-color: #E2DBEE;
                color: #7D768C;
                border-top-left-radius: 10px;
                border-bottom-left-radius: 10px;
            }

            .form-control {
                background-color: #FAFAFC;
                border-color: #E2DBEE;
                color: var(--dark-text);
                font-size: 0.9rem;
                padding: 0.65rem 0.85rem;
                border-radius: 10px;
            }

            .input-group .form-control {
                border-top-left-radius: 0;
                border-bottom-left-radius: 0;
                border-left: none;
            }

            .form-control:focus {
                background-color: #FFFFFF;
                border-color: var(--secondary-purple);
                box-shadow: 0 0 0 3px rgba(128, 100, 181, 0.15);
            }

            .form-check-input {
                width: 1.1rem;
                height: 1.1rem;
                border-color: #C7B9E2;
                cursor: pointer;
            }

                .form-check-input:checked {
                    background-color: var(--primary-purple);
                    border-color: var(--primary-purple);
                }

            .form-check-label {
                font-size: 0.85rem;
                color: #5C556B;
            }

            .forgot-password-link {
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--primary-purple);
                text-decoration: none;
            }

                .forgot-password-link:hover {
                    text-decoration: underline;
                }

            .btn-submit {
                background-color: var(--primary-purple);
                color: #FFFFFF;
                font-weight: 600;
                font-size: 0.95rem;
                padding: 0.75rem;
                border-radius: 12px;
                border: none;
                width: 100%;
                transition: background-color 0.2s ease, transform 0.1s ease;
                box-shadow: 0 4px 12px rgba(91, 58, 158, 0.2);
                margin-top: 0.5rem;
            }

                .btn-submit:hover {
                    background-color: #492D82;
                    color: #FFFFFF;
                    transform: translateY(-1px);
                }

            .register-redirect {
                text-align: center;
                margin-top: 1.75rem;
                font-size: 0.88rem;
                color: #7D768C;
            }

                .register-redirect a {
                    color: var(--primary-purple);
                    font-weight: 600;
                    text-decoration: none;
                }

                    .register-redirect a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>
<body>

    <!-- Brand Header -->
    <div class="brand-header">
        <div class="brand-logo-box">
            <i class="bi bi-calendar2-week"></i>
        </div>
        <h1 class="brand-title">Eventora</h1>
        <div class="brand-subtitle">UNIVERSITY EVENT MANAGEMENT SYSTEM</div>
    </div>

    <!-- Login Card Container -->
    <div class="login-card">
        <div class="card-heading">
            <h2>Welcome Back!</h2>
            <p>Sign in to your Eventora account</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <!-- Email Address -->
            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="email" class="form-control" placeholder="Enter your email address" required />
                </div>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Enter your password" required />
                </div>
            </div>

            <!-- Remember Me & Forgot Password Row -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check m-0">
                    <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">Remember Me</label>
                </div>
                <a href="#" class="forgot-password-link">Forgot Password?</a>
            </div>

            <!-- Login Button -->
            <button type="submit" class="btn-submit">Login</button>
        </form>

        <!-- Register Redirect Footer -->
        <div class="register-redirect">
            Don't have an account? <a asp-controller="Account" asp-action="Register">Register Here</a>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>