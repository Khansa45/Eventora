@{
    Layout = null;
    var roleHint = ViewBag.RoleHint as string;
    var roleLabel = ViewBag.RoleLabel as string ?? "Eventora Account";
    var emailValue = ViewBag.Email as string ?? string.Empty;
    ViewData["Title"] = string.IsNullOrEmpty(roleHint) ? "Eventora - Login" : $"Eventora - {roleLabel} Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/site.css" asp-append-version="true" rel="stylesheet" />
</head>
<body class="eventora-auth-body">
    <main class="eventora-auth-shell">
        <header class="eventora-auth-header">
            <div class="eventora-auth-logo">
                <i class="bi bi-calendar2-week"></i>
            </div>
            <h1 class="eventora-auth-title">Eventora</h1>
            <div class="eventora-auth-subtitle">University Event Management System</div>
        </header>

        <div class="eventora-auth-card">
            <div class="card-heading">
                @if (!string.IsNullOrEmpty(roleHint))
                {
                    <span class="eventora-role-pill">
                        <i class="bi bi-shield-lock"></i> @roleLabel
                    </span>
                }
                <h2>Welcome back</h2>
                <p>Sign in with your Eventora credentials.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post">
                @if (!string.IsNullOrEmpty(roleHint))
                {
                    <input type="hidden" name="role" value="@roleHint" />
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" id="email" name="email" value="@emailValue" class="form-control" placeholder="Enter your email address" autocomplete="username" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check m-0">
                        <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>
                </div>

                <button type="submit" class="btn eventora-submit-btn">
                    Sign in <i class="bi bi-box-arrow-in-right ms-2"></i>
                </button>
            </form>

            <div class="eventora-auth-footer">
                Need a student account? <a asp-controller="Account" asp-action="Register">Register here</a>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
